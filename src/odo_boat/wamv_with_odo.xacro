<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wamv">

  <xacro:include filename="$(find wamv_gazebo)/urdf/wamv_gazebo.urdf.xacro"/>

  <gazebo>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">

      <odom_frame>world</odom_frame>
      <robot_base_frame>wamv/base_link</robot_base_frame>
      <odom_topic>/model/wamv/odometry</odom_topic>
      <tf_topic>/model/wamv/odometry_tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>

    </plugin>
  </gazebo>

</robot>